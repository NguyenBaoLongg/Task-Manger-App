enum PenaltySettlementStatus {
  PENDING
  SUBMITTED
  CONFIRMED
  REJECTED
  WAIVED
  REFUNDED
}

enum RequestType {
  SHIFT_CHANGE
  LATE_NOTICE
  LEAVE_SCHEDULE
  SUDDEN_LEAVE
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

enum ApprovalStepMode {
  SEQUENTIAL
  PARALLEL
}

enum ApprovalStepStatus {
  PENDING
  ACTIVE
  COMPLETED
  SKIPPED
}

enum ApprovalDecision {
  APPROVE
  REJECT
  REQUEST_CHANGES
  CANCEL
}

enum LeaveDurationKind {
  FULL_DAY
  MORNING_HALF
  DATE_RANGE
}

enum OffCalendarScope {
  TENANT
  BRANCH
}

enum LeaveConflictResult {
  CLEAR
  CONFLICT
  WARNING
}

enum AttendanceJobRunStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  fullName            String?    @map("full_name") @db.VarChar(120)
  fullNameConfirmedAt DateTime?  @map("full_name_confirmed_at") @db.Timestamptz(3)
  status              UserStatus @default(ACTIVE)
  locale              String     @default("vi-VN") @db.VarChar(16)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("users")
}

model ExternalIdentity {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  provider        IdentityProvider
  providerSubject String           @map("provider_subject") @db.VarChar(255)
  email           String?          @db.VarChar(320)
  emailVerified   Boolean          @default(false) @map("email_verified")
  lastLoginAt     DateTime         @default(now()) @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("external_identities")
}

model AuthSession {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  refreshTokenHash    String    @unique @map("refresh_token_hash") @db.VarChar(128)
  tokenFamilyId       String    @map("token_family_id") @db.Uuid
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokeReason        String?   @map("revoke_reason") @db.VarChar(160)
  replacedBySessionId String?   @map("replaced_by_session_id") @db.Uuid
  deviceLabel         String?   @map("device_label") @db.VarChar(120)
  userAgentHash       String?   @map("user_agent_hash") @db.VarChar(128)
  ipPrefix            String?   @map("ip_prefix") @db.VarChar(64)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt          DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)

  @@index([userId, revokedAt, expiresAt])
  @@index([tokenFamilyId])
  @@map("auth_sessions")
}

model NotificationEndpoint {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  platform         EndpointPlatform
  provider         PushProvider
  tokenCiphertext  String           @map("token_ciphertext") @db.Text
  tokenFingerprint String           @map("token_fingerprint") @db.VarChar(128)
  status           EndpointStatus   @default(ACTIVE)
  lastSeenAt       DateTime?        @map("last_seen_at") @db.Timestamptz(3)
  revokedAt        DateTime?        @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([userId, tokenFingerprint])
  @@map("notification_endpoints")
}

model Permission {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @unique @db.VarChar(80)
  description   String   @db.VarChar(255)
  allowedScopes Json     @map("allowed_scopes") @db.JsonB
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("permissions")
}

model SecurityEvent {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String?  @map("user_id") @db.Uuid
  sessionId        String?  @map("session_id") @db.Uuid
  eventType        String   @map("event_type") @db.VarChar(100)
  correlationId    String   @map("correlation_id") @db.VarChar(100)
  ipPrefix         String?  @map("ip_prefix") @db.VarChar(64)
  userAgentHash    String?  @map("user_agent_hash") @db.VarChar(128)
  metadataRedacted Json?    @map("metadata_redacted") @db.JsonB
  occurredAt       DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@index([userId, occurredAt])
  @@map("security_events")
}

model AccountIdempotencyRecord {
  id                     String            @id @default(uuid()) @db.Uuid
  userId                 String            @map("user_id") @db.Uuid
  operation              String            @db.VarChar(100)
  key                    String            @db.VarChar(160)
  requestHash            String            @map("request_hash") @db.VarChar(128)
  status                 IdempotencyStatus @default(PROCESSING)
  responseStatus         Int?              @map("response_status")
  responseBodyRedacted   Json?             @map("response_body_redacted") @db.JsonB
  responseBodyCiphertext String?           @map("response_body_ciphertext") @db.Text
  resourceId             String?           @map("resource_id") @db.Uuid
  lockedUntil            DateTime          @map("locked_until") @db.Timestamptz(3)
  expiresAt              DateTime          @map("expires_at") @db.Timestamptz(3)
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([userId, operation, key])
  @@map("account_idempotency_records")
}

model Tenant {
  id              String       @id @default(uuid()) @db.Uuid
  name            String       @db.VarChar(160)
  slug            String       @unique @db.VarChar(100)
  timezone        String       @default("Asia/Ho_Chi_Minh") @db.VarChar(64)
  status          TenantStatus @default(ACTIVE)
  settings        Json         @default("{}") @db.JsonB
  createdByUserId String       @map("created_by_user_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("tenants")
}

model Branch {
  tenantId              String         @map("tenant_id") @db.Uuid
  id                    String         @default(uuid()) @db.Uuid
  code                  String         @db.VarChar(50)
  name                  String         @db.VarChar(160)
  timezoneOverride      String?        @map("timezone_override") @db.VarChar(64)
  status                ResourceStatus @default(ACTIVE)
  createdByMembershipId String?        @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("branches")
}

model Department {
  tenantId  String         @map("tenant_id") @db.Uuid
  id        String         @default(uuid()) @db.Uuid
  code      String         @db.VarChar(50)
  name      String         @db.VarChar(160)
  status    ResourceStatus @default(ACTIVE)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([tenantId, id])
  @@unique([tenantId, code])
  @@map("departments")
}

model Position {
  tenantId  String         @map("tenant_id") @db.Uuid
  id        String         @default(uuid()) @db.Uuid
  code      String         @db.VarChar(50)
  name      String         @db.VarChar(160)
  status    ResourceStatus @default(ACTIVE)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([tenantId, id])
  @@unique([tenantId, code])
  @@map("positions")
}

model TenantMembership {
  tenantId              String           @map("tenant_id") @db.Uuid
  id                    String           @default(uuid()) @db.Uuid
  userId                String           @map("user_id") @db.Uuid
  membershipDisplayName String           @map("membership_display_name") @db.VarChar(120)
  employeeCode          String?          @map("employee_code") @db.VarChar(50)
  status                MembershipStatus @default(INVITED)
  joinedAt              DateTime?        @map("joined_at") @db.Timestamptz(3)
  suspendedAt           DateTime?        @map("suspended_at") @db.Timestamptz(3)
  leftAt                DateTime?        @map("left_at") @db.Timestamptz(3)
  version               Int              @default(1)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([tenantId, id])
  @@unique([tenantId, userId])
  @@unique([tenantId, employeeCode])
  @@index([tenantId, status])
  @@map("tenant_memberships")
}

model Assignment {
  tenantId              String           @map("tenant_id") @db.Uuid
  id                    String           @default(uuid()) @db.Uuid
  membershipId          String           @map("membership_id") @db.Uuid
  branchId              String           @map("branch_id") @db.Uuid
  departmentId          String?          @map("department_id") @db.Uuid
  positionId            String?          @map("position_id") @db.Uuid
  effectiveFrom         DateTime         @map("effective_from") @db.Timestamptz(3)
  effectiveTo           DateTime?        @map("effective_to") @db.Timestamptz(3)
  status                AssignmentStatus @default(ACTIVE)
  createdByMembershipId String           @map("created_by_membership_id") @db.Uuid
  reason                String?          @db.VarChar(500)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([tenantId, id])
  @@index([tenantId, membershipId, effectiveFrom, effectiveTo])
  @@index([tenantId, branchId, effectiveFrom, effectiveTo])
  @@map("assignments")
}

model Role {
  tenantId  String     @map("tenant_id") @db.Uuid
  id        String     @default(uuid()) @db.Uuid
  code      String     @db.VarChar(80)
  name      String     @db.VarChar(120)
  kind      RoleKind
  status    RoleStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([tenantId, id])
  @@unique([tenantId, code])
  @@map("roles")
}

model RolePermission {
  tenantId     String   @map("tenant_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([tenantId, roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model MembershipRoleBinding {
  tenantId              String    @map("tenant_id") @db.Uuid
  id                    String    @default(uuid()) @db.Uuid
  membershipId          String    @map("membership_id") @db.Uuid
  roleId                String    @map("role_id") @db.Uuid
  scopeType             ScopeType @map("scope_type")
  branchId              String?   @map("branch_id") @db.Uuid
  effectiveFrom         DateTime  @map("effective_from") @db.Timestamptz(3)
  effectiveTo           DateTime? @map("effective_to") @db.Timestamptz(3)
  grantedByMembershipId String    @map("granted_by_membership_id") @db.Uuid
  reason                String?   @db.VarChar(500)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([tenantId, id])
  @@unique([tenantId, membershipId, roleId, scopeType, branchId, effectiveFrom])
  @@index([tenantId, membershipId, effectiveFrom, effectiveTo])
  @@map("membership_role_bindings")
}

model Invitation {
  tenantId              String         @map("tenant_id") @db.Uuid
  id                    String         @default(uuid()) @db.Uuid
  tokenHash             String         @unique @map("token_hash") @db.VarChar(128)
  tokenHint             String         @map("token_hint") @db.VarChar(16)
  invitationType        InvitationType @map("invitation_type")
  roleId                String         @map("role_id") @db.Uuid
  branchId              String?        @map("branch_id") @db.Uuid
  maxUses               Int            @default(1) @map("max_uses")
  useCount              Int            @default(0) @map("use_count")
  expiresAt             DateTime       @map("expires_at") @db.Timestamptz(3)
  revokedAt             DateTime?      @map("revoked_at") @db.Timestamptz(3)
  createdByMembershipId String         @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([tenantId, id])
  @@index([tenantId, expiresAt, revokedAt])
  @@map("invitations")
}

model InvitationAcceptance {
  tenantId      String   @map("tenant_id") @db.Uuid
  id            String   @default(uuid()) @db.Uuid
  invitationId  String   @map("invitation_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  membershipId  String   @map("membership_id") @db.Uuid
  acceptedAt    DateTime @default(now()) @map("accepted_at") @db.Timestamptz(3)
  correlationId String   @map("correlation_id") @db.VarChar(100)

  @@id([tenantId, id])
  @@unique([tenantId, invitationId, userId])
  @@map("invitation_acceptances")
}

model FormTemplate {
  tenantId                  String             @map("tenant_id") @db.Uuid
  id                        String             @default(uuid()) @db.Uuid
  code                      String             @db.VarChar(80)
  name                      String             @db.VarChar(160)
  description               String?            @db.VarChar(1000)
  status                    FormTemplateStatus @default(ACTIVE)
  currentPublishedVersionId String?            @map("current_published_version_id") @db.Uuid
  createdByMembershipId     String             @map("created_by_membership_id") @db.Uuid
  createdAt                 DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([tenantId, id])
  @@unique([tenantId, code])
  @@map("form_templates")
}

model FormVersion {
  tenantId                String            @map("tenant_id") @db.Uuid
  id                      String            @default(uuid()) @db.Uuid
  formTemplateId          String            @map("form_template_id") @db.Uuid
  versionNumber           Int               @map("version_number")
  status                  FormVersionStatus @default(DRAFT)
  jsonSchema              Json              @map("json_schema") @db.JsonB
  uiSchema                Json?             @map("ui_schema") @db.JsonB
  effectiveFrom           DateTime?         @map("effective_from") @db.Timestamptz(3)
  publishedAt             DateTime?         @map("published_at") @db.Timestamptz(3)
  publishedByMembershipId String?           @map("published_by_membership_id") @db.Uuid
  createdAt               DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([tenantId, id])
  @@unique([tenantId, formTemplateId, versionNumber])
  @@map("form_versions")
}

model FormSubmission {
  tenantId                String               @map("tenant_id") @db.Uuid
  id                      String               @default(uuid()) @db.Uuid
  formTemplateId          String               @map("form_template_id") @db.Uuid
  formVersionId           String               @map("form_version_id") @db.Uuid
  submittedByMembershipId String               @map("submitted_by_membership_id") @db.Uuid
  branchId                String?              @map("branch_id") @db.Uuid
  data                    Json                 @db.JsonB
  status                  FormSubmissionStatus @default(SUBMITTED)
  submittedAt             DateTime             @default(now()) @map("submitted_at") @db.Timestamptz(3)
  voidedAt                DateTime?            @map("voided_at") @db.Timestamptz(3)
  voidReason              String?              @map("void_reason") @db.VarChar(500)
  idempotencyKey          String               @map("idempotency_key") @db.VarChar(160)
  supersedesSubmissionId  String?              @map("supersedes_submission_id") @db.Uuid
  createdAt               DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([tenantId, id])
  @@unique([tenantId, submittedByMembershipId, idempotencyKey])
  @@index([tenantId, formTemplateId, submittedAt])
  @@map("form_submissions")
}

model ChatChannel {
  tenantId              String            @map("tenant_id") @db.Uuid
  id                    String            @default(uuid()) @db.Uuid
  type                  ChatChannelType
  name                  String            @db.VarChar(160)
  branchId              String?           @map("branch_id") @db.Uuid
  status                ChatChannelStatus @default(ACTIVE)
  createdByMembershipId String            @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([tenantId, id])
  @@index([tenantId, type, status])
  @@map("chat_channels")
}

model ChatChannelMembership {
  tenantId          String          @map("tenant_id") @db.Uuid
  channelId         String          @map("channel_id") @db.Uuid
  membershipId      String          @map("membership_id") @db.Uuid
  role              ChatChannelRole @default(MEMBER)
  joinedAt          DateTime        @default(now()) @map("joined_at") @db.Timestamptz(3)
  leftAt            DateTime?       @map("left_at") @db.Timestamptz(3)
  lastReadMessageId String?         @map("last_read_message_id") @db.Uuid

  @@id([tenantId, channelId, membershipId])
  @@index([tenantId, membershipId, leftAt])
  @@map("chat_channel_memberships")
}

model ChatMessage {
  tenantId                  String      @map("tenant_id") @db.Uuid
  id                        String      @default(uuid()) @db.Uuid
  channelId                 String      @map("channel_id") @db.Uuid
  authorMembershipId        String      @map("author_membership_id") @db.Uuid
  authorDisplayNameSnapshot String      @map("author_display_name_snapshot") @db.VarChar(120)
  clientMessageId           String      @map("client_message_id") @db.VarChar(100)
  body                      String      @db.Text
  messageType               MessageType @default(TEXT) @map("message_type")
  replyToMessageId          String?     @map("reply_to_message_id") @db.Uuid
