generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum IdentityProvider {
  GOOGLE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum ResourceStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  LEFT
}

enum AssignmentStatus {
  ACTIVE
  ENDED
  CANCELLED
}

enum RoleKind {
  SYSTEM
  CUSTOM
}

enum RoleStatus {
  ACTIVE
  ARCHIVED
}

enum ScopeType {
  TENANT
  BRANCH
}

enum InvitationType {
  DIRECT
  GROUP_LINK
}

enum FormTemplateStatus {
  ACTIVE
  ARCHIVED
}

enum FormVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum FormSubmissionStatus {
  SUBMITTED
  VOIDED
}

enum ChatChannelType {
  TENANT_GENERAL
  BRANCH
  GROUP
}

enum ChatChannelStatus {
  ACTIVE
  ARCHIVED
}

enum ChatChannelRole {
  MEMBER
  MODERATOR
}

enum MessageType {
  TEXT
  SYSTEM
}

enum MediaStatus {
  PENDING_UPLOAD
  READY
  REJECTED
  DELETED
}

enum MediaPurpose {
  CHECKIN
  BOOKING
  FORM_EVIDENCE
  CHAT_ATTACHMENT
  PROFILE
  OTHER
}

enum EndpointPlatform {
  IOS
  ANDROID
}

enum PushProvider {
  FCM
  APNS
}

enum EndpointStatus {
  ACTIVE
  INVALID
  REVOKED
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED_RETRYABLE
}

enum KpiValueType {
  MONEY
  COUNT
  PERCENTAGE
}

enum KpiDirection {
  AT_LEAST
  AT_MOST
}

enum KpiSourceType {
  FORM_FIELD
  DOMAIN_ADAPTER
}

enum KpiScopeType {
  TENANT
  BRANCH
  DEPARTMENT
  GROUP
  MEMBERSHIP
}

enum DailyKpiPolicyScopeType {
  TENANT
  BRANCH
}

enum KpiReportStatus {
  OPEN
  SUBMITTED
  LATE
  CLOSED
}

enum KpiEvaluationStatus {
  PASSED
  FAILED
  EXEMPT
}

enum KpiPenaltyKind {
  DAILY_KPI
  PHOTO_EVIDENCE
}

enum KpiPenaltyStatus {
  ASSESSED
  FULLY_REVERSED
}

enum EvidenceDebtStatus {
  WAITING_PHOTOS
  SATISFIED
  OVERDUE
  WAIVED
}

enum ActionItemState {
  OPEN
  OVERDUE
  COMPLETED
  DISMISSED
}

enum ActionItemType {
  KPI_REPORT
  KPI_SHORTFALL
  PHOTO_DEBT
  DATA_QUALITY
}

enum KpiJobRunStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  DEAD_LETTER
}

enum ShiftStatus {
  ACTIVE
  RETIRED
}

enum ScheduleState {
  SCHEDULED
  OFF
  LEAVE_APPROVED
  ADJUSTED
  CANCELLED
}

enum ScheduleChangeKind {
  SELF_EDIT
  CHANGE_REQUEST
  MANAGER_ADJUSTMENT
  OFF_CALENDAR
  LEAVE_APPROVAL
}

enum AttendanceState {
  PENDING_VIDEO
  VIDEO_UPLOADED
  CONFIRMED
  MISSING_CHECK_IN
  NON_WORKED
  EXEMPT_OFF
}

enum VideoProcessingState {
  REQUESTED
  UPLOADED
  VERIFYING
  CONVERTING
  READY
  FAILED_RETRYABLE
  FAILED_FINAL
}

enum VideoReviewStatus {
  PENDING
  PASSED
  FAILED
  WAIVED
}

enum DayWorkClassification {
  WORKED_ON_TIME
  WORKED_LATE
  NON_WORKED_NO_CHECKIN
  OFF_OR_APPROVED_LEAVE
}

enum ViolationKind {
  MISSING_CHECK_IN
  VIDEO_STANDARD_FAILED
  LATE_BASE
  LATE_NO_NOTICE
  SUDDEN_LEAVE_NO_NOTICE
  SUDDEN_LEAVE_OVER_LIMIT
  LEAVE_RULE_VIOLATION
