  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([tenantId, id])
  @@unique([tenantId, dedupeKey])
  @@index([status, availableAt, id])
  @@index([tenantId, aggregateType, aggregateId, createdAt])
  @@map("outbox_events")
}
