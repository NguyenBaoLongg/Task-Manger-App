NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://adsup:adsup@127.0.0.1:5432/adsup
AUTH_GOOGLE_MODE=fake
GOOGLE_CLIENT_ID=
JWT_ISSUER=adsup-api
JWT_AUDIENCE=adsup-mobile
JWT_ACCESS_SECRET=local-only-change-me-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
OBJECT_STORAGE_DRIVER=memory
S3_REGION=ap-southeast-1
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
PUSH_DRIVER=noop
# PUSH_DRIVER=webhook
# PUSH_WEBHOOK_URL=https://push-relay.internal.example/v1/events
# PUSH_WEBHOOK_SECRET=replace-with-at-least-32-characters
REALTIME_BACKPLANE=memory
REDIS_URL=
SIGNED_URL_TTL_SECONDS=300
