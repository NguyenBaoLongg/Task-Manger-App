{
  "name": "@adsup/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "node scripts/expo.cjs start",
    "test": "jest --config jest.config.js --runInBand",
    "test:contract": "jest --config jest.config.js --runInBand tests/contract",
    "test:integration": "jest --config jest.config.js --runInBand tests/integration",
    "test:e2e": "detox test --configuration ios.phone.light",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "build": "node scripts/expo.cjs export --platform all",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "@tanstack/react-query": "5.66.8",
    "expo": "54.0.36",
    "expo-camera": "17.0.10",
    "expo-constants": "18.0.13",
    "expo-file-system": "19.0.23",
    "expo-linking": "8.0.12",
    "expo-notifications": "0.32.17",
    "expo-router": "5.1.11",
    "expo-secure-store": "15.0.8",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "5.6.0",
    "react-native-screens": "~4.16.0",
    "socket.io-client": "4.8.1",
    "zod": "4.4.3",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@testing-library/jest-native": "5.4.3",
    "@testing-library/react-native": "13.2.0",
    "@types/jest": "29.5.14",
    "@types/node": "24.0.0",
    "@types/react": "19.1.17",
    "babel-plugin-module-resolver": "5.0.2",
    "babel-preset-expo": "54.0.12",
    "detox": "20.51.4",
    "jest": "29.7.0",
    "jest-expo": "54.0.17",
    "metro": "0.82.5",
    "metro-runtime": "0.82.5",
    "typescript": "5.9.3"
  }
}
