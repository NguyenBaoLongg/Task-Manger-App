{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": false,
    "types": ["jest", "node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "expo-file-system/legacy": ["./types/expo-file-system-legacy.d.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "app.config.ts"]
}
